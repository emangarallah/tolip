# Optional AI integration key. Keep server-side only; never prefix with VITE_.
# No current browser module should read this variable.
GEMINI_API_KEY=

# Public canonical origin of the deployed storefront.
APP_URL=

# Production persistence through Neon PostgreSQL.
# Configure the least-privilege RLS-enabled tolip_runtime connection in Vercel.
# This credential is server-only and must never be exposed with a VITE_ prefix.
DATABASE_URL=

# Generate a unique random secret: openssl rand -base64 48
# Production requires at least 32 characters. Store as a Sensitive Vercel variable.
AUTH_SECRET=

# Initial administrator bootstrap credentials. The account password is stored as
# a scrypt hash with a unique salt in Neon; do not reuse this password elsewhere.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vercel Blob token for production image uploads. Store as Sensitive.
BLOB_READ_WRITE_TOKEN=
