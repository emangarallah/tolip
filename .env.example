# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL / Neon connection string (e.g. postgresql://user:pass@ep-xxx.neon.tech/tulip_db).
# If omitted, Tulip Store automatically uses the persistent relational file database at data/store_database.json.
DATABASE_URL=""

# AUTH_SECRET: Secret key for signing and verifying admin authentication session tokens.
AUTH_SECRET="change-this-to-a-secure-random-secret-key"

# ADMIN_EMAIL: Default email address for the store owner admin dashboard.
ADMIN_EMAIL="admin@tulip.ye"

# ADMIN_PASSWORD: Initial password for admin access (can be updated inside the dashboard).
ADMIN_PASSWORD="tulip_admin_secure_2026"

