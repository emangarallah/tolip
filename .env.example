# Gemini API key (only needed if optional AI features are enabled)
GEMINI_API_KEY=

# Public origin of the deployed storefront
APP_URL=

# IMPORTANT: The current codebase uses data/store_database.json as its data store.
# DATABASE_URL is documented for future Neon integration but is NOT currently used
# by src/server/db.ts. Do not deploy as a multi-instance/serverless production store
# until a persistent database adapter is implemented and verified.
DATABASE_URL=

# Generate a unique secret: openssl rand -base64 48
# Production requires at least 32 characters.
AUTH_SECRET=

# Production admin credentials are read from deployment environment variables.
# Use a unique email and a password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production image uploads require durable object storage (not local public/uploads).
# Configure an S3-compatible provider and implement its adapter before enabling uploads.
